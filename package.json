{
  "name": "app-export-kit",
  "version": "2.1.0",
  "description": "Reusable data export for React Native / Expo apps (iOS, Android, web): Excel-safe CSV, a PDF report from a plain description, and save or share the file (share sheet on phones, download on web). No app words or colors: the app passes its look.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./pdf": "./pdf.ts",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "src",
    "pdf.ts"
  ],
  "sideEffects": false,
  "author": "Yuvaraj Salla",
  "peerDependencies": {
    "app-core-kit": ">=1.11.0",
    "expo-file-system": ">=19",
    "expo-print": ">=14",
    "expo-sharing": ">=13",
    "react-native": ">=0.74"
  },
  "peerDependenciesMeta": {
    "expo-print": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "app-core-kit": "git+https://github.com/yuvarajsalla20/app-core-kit.git#c9457e9c7908078a368af3c6f03e5d022baf26f8",
    "react": "19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p ."
  }
}
